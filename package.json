{
  "name": "svenjungnickel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "NITRO_PRESET=static nuxt preview",
    "lint:js": "oxlint",
    "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\" --ignore-path .gitignore",
    "lint:prettier": "prettier --check \"**/*.{js,ts,vue,json,md,yml,yaml}\"",
    "lint": "npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lintfix": "prettier --write --list-different \"**/*.{js,ts,vue,json,md,yml,yaml}\" && npm run lint:js -- --fix && npm run lint:style -- --fix",
    "prepare": "husky install",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "lhci:mobile": "lhci autorun",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.2.0",
    "core-js": "^3.51.0",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.15.1",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/stylelint-module": "^5.2.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.5.1",
    "better-sqlite3": "^13.0.3",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.107.0",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  }
}
